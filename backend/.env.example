# --- Aplicação ---
NODE_ENV=development
PORT=3000
# Origem do frontend (CORS e links nos e-mails)
FRONTEND_URL=http://localhost:5173
# URL pública da API (usada nos links de webhook/checkout)
API_URL=http://localhost:3000

# --- Banco (MySQL) ---
# docker compose:      mysql://seguradora:seguradora@localhost:3306/seguradora
# sem Docker (npm run db:local): mysql://root@127.0.0.1:3307/seguradora
DATABASE_URL=mysql://seguradora:seguradora@localhost:3306/seguradora

# --- Autenticação ---
JWT_ACCESS_SECRET=troque-este-segredo-de-acesso
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# --- Consulta de IMEI ---
# mock = MockImeiProvider (dados fixos) | http = HttpImeiProvider (API externa)
IMEI_PROVIDER=mock
IMEI_API_URL=
IMEI_API_KEY=
IMEI_API_TIMEOUT_MS=5000
IMEI_CACHE_HOURS=24

# --- Pagamentos ---
# mock = MockPaymentGateway | mercadopago = MercadoPagoGateway (sandbox)
PAYMENT_GATEWAY=mock
# Segredo usado para assinar/validar webhooks (mock e Mercado Pago)
PAYMENT_WEBHOOK_SECRET=troque-este-segredo-do-webhook
MERCADOPAGO_ACCESS_TOKEN=
# Resultado automático das renovações no cartão com o gateway mock: approve | decline
MOCK_RENEWAL_OUTCOME=approve

# --- E-mail (SMTP) ---
# Com docker compose o Mailpit fica em localhost:1025 (interface em http://localhost:8025).
# Sem SMTP_HOST, os e-mails são apenas registrados no log.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Seguradora de Celular <nao-responda@seguradora.local>"

# --- Uploads ---
UPLOAD_DIR=./storage

# --- Ferramentas de desenvolvimento (rotas /api/dev/*). Nunca habilitar em produção. ---
ENABLE_DEV_TOOLS=true
